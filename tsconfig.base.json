{
  "compileOnSave": false,
  "compilerOptions": {
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": false,
    "target": "es2022",
    "module": "esnext",
    "lib": ["es2022", "dom"],
    "types": ["jest", "node"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@pactintel/shared-types": ["libs/shared-types/src/index.ts"],
      "@pactintel/shared-types/*": ["libs/shared-types/src/*"],
      "@pactintel/shared-utils": ["libs/shared-utils/src/index.ts"],
      "@pactintel/shared-utils/*": ["libs/shared-utils/src/*"],
      "@pactintel/ui": ["libs/ui/src/index.ts"],
      "@pactintel/ui/*": ["libs/ui/src/*"],
      "@pactintel/data-manifest": ["libs/data-manifest/src/index.ts"],
      "@pactintel/data-manifest/*": ["libs/data-manifest/src/*"],
      "@pactintel/ai": ["libs/ai/src/index.ts"],
      "@pactintel/ai/*": ["libs/ai/src/*"]
    },
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true
  },
  "exclude": ["node_modules", "tmp", "dist"]
}
