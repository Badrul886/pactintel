# ==============================================================================
# PactIntel Environment Variables Example
# Copy to .env for local development
# ==============================================================================

NODE_ENV=development
APP_ENV=local
CELL_ID=local-dev
PORT=4000

# Web Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_VIEWER_URL=http://localhost:3000

# Primary Database (Cloud SQL PostgreSQL 17 / Local Docker)
DATABASE_URL=postgresql://postgres:local@localhost:5432/pactintel?schema=public

# Memorystore / Redis Role-Split Instances (Local Docker)
REDIS_QUEUE_URL=redis://localhost:6379
REDIS_SESSION_URL=redis://localhost:6380
REDIS_CACHE_URL=redis://localhost:6381
REDIS_REALTIME_URL=redis://localhost:6382

# Analytics (ClickHouse Cloud / Local Docker)
CLICKHOUSE_HOST=http://localhost:8123
CLICKHOUSE_DB=default
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Object Storage (GCS Emulator - SeaweedFS Local Docker)
STORAGE_ENDPOINT=http://localhost:8333
STORAGE_REGION=us-central1
STORAGE_ACCESS_KEY=local
STORAGE_SECRET_KEY=local
STORAGE_EVIDENCE_BUCKET=pactintel-dev-evidence
STORAGE_UPLOADS_BUCKET=pactintel-dev-uploads

# Email (Mailpit Local Docker / Resend Cloud)
SMTP_HOST=localhost
SMTP_PORT=1025
RESEND_API_KEY=re_local_sandbox

# AuthKit (WorkOS)
WORKOS_CLIENT_ID=client_local_placeholder
WORKOS_API_KEY=sk_local_placeholder
WORKOS_WEBHOOK_SECRET=whsec_local_placeholder
SESSION_SECRET=super-secret-development-session-key-minimum-32-chars

# E-Signature (BoldSign)
BOLDSIGN_API_KEY=boldsign_local_placeholder
BOLDSIGN_WEBHOOK_SECRET=boldsign_whsec_placeholder

# Platform Billing (Paddle)
PADDLE_API_KEY=paddle_local_placeholder
PADDLE_WEBHOOK_SECRET=paddle_whsec_placeholder
PADDLE_ENVIRONMENT=sandbox

# Search Engine (Meilisearch / Local Docker)
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=pactintel_local_master_key_12345

# OCR (Google Cloud Vision API)
GOOGLE_APPLICATION_CREDENTIALS=

# Telemetry & Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=debug

# Risk Scoring Vendor (Sprint 3.7)
RISK_SCORING_VENDOR_URL=https://api.sift.com/v205/score
RISK_SCORING_API_KEY=sift_api_key_placeholder
RISK_SCORING_TIMEOUT_MS=5000

# Enterprise Identity & SCIM (Sprint 3.9)
SCIM_API_KEY=0123456789abcdef0123456789abcdef

# Mobile Push Notifications - FCM / APNs (Sprint 3.12)
FIREBASE_PROJECT_ID=pactintel-fcm-dev
FIREBASE_SERVER_KEY=fcm_server_key_placeholder
APNS_KEY_ID=apns_key_id_placeholder
APNS_TEAM_ID=apns_team_id_placeholder
APNS_BUNDLE_ID=com.pactintel.app
