{
  "name": "pactintel",
  "version": "0.1.0",
  "private": true,
  "description": "PactIntel - Contract lifecycle and e-signature platform",
  "scripts": {
    "build": "nx run-many --target=build --all",
    "test": "nx run-many --target=test --all",
    "lint": "nx run-many --target=lint --all",
    "typecheck": "nx run-many --target=typecheck --all",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "check:manifest": "tsx tools/scripts/check-data-manifest.ts",
    "check:forbidden-patterns": "tsx tools/scripts/check-forbidden-patterns.ts",
    "test:e2e": "pnpm --filter @pactintel/web-e2e e2e",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "@nx/eslint-plugin": "^20.8.4",
    "@nx/js": "^20.4.4",
    "@nx/nest": "^20.4.4",
    "@nx/next": "^20.4.4",
    "@nx/node": "^20.4.4",
    "@nx/playwright": "^20.4.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.4",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "eslint": "^9.20.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-import": "^2.31.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "nx": "^20.4.4",
    "prettier": "^3.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
