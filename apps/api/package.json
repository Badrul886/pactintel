{
  "name": "@pactintel/api",
  "version": "0.1.0",
  "private": true,
  "nx": {
    "tags": [
      "scope:api"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/apps/api/src/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "prisma:generate": "prisma generate --schema=src/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=src/prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema=src/prisma/schema.prisma",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:cov": "jest --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@casl/ability": "^6.7.3",
    "@google-cloud/aiplatform": "^7.7.0",
    "@nestjs/common": "^11.0.10",
    "@nestjs/core": "^11.0.10",
    "@nestjs/platform-express": "^11.0.10",
    "@nestjs/terminus": "^11.0.0",
    "@pactintel/ai": "workspace:*",
    "@pactintel/data-manifest": "workspace:*",
    "@pactintel/shared-types": "workspace:*",
    "@pactintel/shared-utils": "workspace:*",
    "@prisma/client": "^6.4.1",
    "bullmq": "^6.4.1",
    "decimal.js": "^10.6.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.5.0",
    "nestjs-cls": "^5.0.0",
    "nestjs-pino": "^4.3.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "rxjs": "^7.8.1",
    "uuid": "^10.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.4",
    "@nestjs/schematics": "^11.0.1",
    "@nestjs/testing": "^11.0.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.4",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.4.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3"
  }
}
