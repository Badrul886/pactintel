{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "declaration": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "es2022",
    "sourceMap": true,
    "outDir": "../../dist/apps/api",
    "baseUrl": "./",
    "paths": {
      "@pactintel/shared-types": ["../../libs/shared-types/src/index.ts"],
      "@pactintel/shared-types/*": ["../../libs/shared-types/src/*"],
      "@pactintel/shared-utils": ["../../libs/shared-utils/src/index.ts"],
      "@pactintel/shared-utils/*": ["../../libs/shared-utils/src/*"],
      "@pactintel/ui": ["../../libs/ui/src/index.ts"],
      "@pactintel/ui/*": ["../../libs/ui/src/*"],
      "@pactintel/data-manifest": ["../../libs/data-manifest/src/index.ts"],
      "@pactintel/data-manifest/*": ["../../libs/data-manifest/src/*"],
      "@pactintel/ai": ["../../libs/ai/src/index.ts"],
      "@pactintel/ai/*": ["../../libs/ai/src/*"],
      "@pactintel/i18n": ["../../libs/i18n/src/index.ts"],
      "@pactintel/i18n/*": ["../../libs/i18n/src/*"],
      "@pactintel/sdk": ["../../libs/sdk/src/index.ts"],
      "@pactintel/sdk/*": ["../../libs/sdk/src/*"]
    },
    "incremental": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["jest", "node"]
  },
  "include": ["src/**/*", "test/**/*"],
  "exclude": ["node_modules", "dist"]
}
