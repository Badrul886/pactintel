// -----------------------------------------------------------------------------

model WorkflowDefinition {
  id             String    @id // UUIDv7
  organizationId String    @map("organization_id")
  workspaceId    String    @map("workspace_id")
  name           String
  description    String?
  triggerEvent   String    @map("trigger_event")
  dag            Json      @default("{\"nodes\":[],\"edges\":[]}")
  status         String    @default("draft") // draft, active, paused, archived
  version        Int       @default(1)
  maxInstances   Int       @default(1000) @map("max_instances")
  createdBy      String    @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator      User               @relation("WorkflowCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  instances    WorkflowInstance[]

  @@index([organizationId])
  @@index([workspaceId])
  @@index([organizationId, status])
  @@map("workflow_definitions")
}

model WorkflowInstance {
  id             String    @id // UUIDv7
  organizationId String    @map("organization_id")
  workflowId     String    @map("workflow_id")
  triggerPayload Json      @default("{}") @map("trigger_payload")
  currentNodeId  String?   @map("current_node_id")
  status         String    @default("running") // running, completed, failed, halted, paused
  chainDepth     Int       @default(0) @map("chain_depth")
  visitedNodes   Json      @default("[]") @map("visited_nodes")
  errorMessage   String?   @map("error_message")
  startedAt      DateTime  @default(now()) @map("started_at")
  completedAt    DateTime? @map("completed_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflow       WorkflowDefinition      @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  nodeExecutions WorkflowNodeExecution[]

  @@index([organizationId])
  @@index([workflowId])
  @@index([organizationId, status])
  @@map("workflow_instances")
}

model WorkflowNodeExecution {
  id             String    @id // UUIDv7
  organizationId String    @map("organization_id")
  instanceId     String    @map("instance_id")
  nodeId         String    @map("node_id")
  nodeType       String    @map("node_type") // trigger, condition, action, risk_assessment, delay, end
  input          Json      @default("{}")
  output         Json?
  status         String    @default("pending") // pending, running, completed, failed, skipped
  startedAt      DateTime? @map("started_at")
  completedAt    DateTime? @map("completed_at")
  errorMessage   String?   @map("error_message")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  instance     WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([instanceId])
  @@map("workflow_node_executions")
}

// -----------------------------------------------------------------------------
// 12. Deal Rooms (Sprint 3.3)
// -----------------------------------------------------------------------------

model DealRoom {
  id               String    @id // UUIDv7
  organizationId   String    @map("organization_id")
  workspaceId      String    @map("workspace_id")
  title            String
  slug             String
  status           String    @default("active") // active, closed, archived
  brandKitId       String?   @map("brand_kit_id")
  mutualActionPlan Json      @default("[]") @map("mutual_action_plan")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace        Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brandKit         BrandKit?          @relation(fields: [brandKitId], references: [id], onDelete: SetNull)
  members          DealRoomMember[]
  documents        DealRoomDocument[]
  messages         DealRoomMessage[]
  magicLinks       DealRoomMagicLink[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([workspaceId])
  @@index([organizationId, status])
  @@map("deal_rooms")
}

model DealRoomMember {
  id             String    @id // UUIDv7
  dealRoomId     String    @map("deal_room_id")
  organizationId String    @map("organization_id")
  userId         String?   @map("user_id")
  externalEmail  String?   @map("external_email")
  externalName   String?   @map("external_name")
  role           String    @default("viewer") // owner, member, viewer
  invitedAt      DateTime  @default(now()) @map("invited_at")
  joinedAt       DateTime? @map("joined_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  dealRoom       DealRoom            @relation(fields: [dealRoomId], references: [id], onDelete: Cascade)
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  magicLinks     DealRoomMagicLink[]

  @@index([dealRoomId])
  @@index([organizationId])
  @@index([dealRoomId, externalEmail])
  @@map("deal_room_members")
}

model DealRoomDocument {
  id             String   @id // UUIDv7
  dealRoomId     String   @map("deal_room_id")
  organizationId String   @map("organization_id")
  documentId     String   @map("document_id")
  addedBy        String   @map("added_by")
  createdAt      DateTime @default(now()) @map("created_at")

  dealRoom       DealRoom     @relation(fields: [dealRoomId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document       Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  addedByUser    User         @relation("DealRoomDocAdder", fields: [addedBy], references: [id], onDelete: Cascade)

  @@unique([dealRoomId, documentId])
  @@index([dealRoomId])
  @@index([organizationId])
  @@map("deal_room_documents")
}

model DealRoomMessage {
  id             String    @id // UUIDv7
  dealRoomId     String    @map("deal_room_id")
  organizationId String    @map("organization_id")
  authorUserId   String?   @map("author_user_id")
  authorEmail    String?   @map("author_email")
  authorName     String?   @map("author_name")
  body           String
  visibility     String    @default("external") // internal, external
  parentId       String?   @map("parent_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  dealRoom       DealRoom          @relation(fields: [dealRoomId], references: [id], onDelete: Cascade)
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  authorUser     User?             @relation("DealRoomMsgAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  parent         DealRoomMessage?  @relation("MessageReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies        DealRoomMessage[] @relation("MessageReplies")

  @@index([dealRoomId, createdAt])
  @@index([dealRoomId, visibility])
  @@index([organizationId])
  @@map("deal_room_messages")
}

model DealRoomMagicLink {
  id             String    @id // UUIDv7
  dealRoomId     String    @map("deal_room_id")
  organizationId String    @map("organization_id")
  memberId       String    @map("member_id")
  tokenHash      String    @unique @map("token_hash")
  expiresAt      DateTime  @map("expires_at")
  usedAt         DateTime? @map("used_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  dealRoom       DealRoom       @relation(fields: [dealRoomId], references: [id], onDelete: Cascade)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member         DealRoomMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([dealRoomId])
  @@index([organizationId])
  @@map("deal_room_magic_links")
}

// -----------------------------------------------------------------------------
// 12. Portfolio Agreement Intelligence (Sprint 3.5)
// -----------------------------------------------------------------------------

model Counterparty {
  id             String    @id // UUIDv7
  organizationId String    @map("organization_id")
  canonicalName  String    @map("canonical_name")
  aliases        String[]  @default([])
  domain         String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents      Document[]

  @@index([organizationId, canonicalName])
  @@index([organizationId])
  @@map("counterparties")
}

model CustomExtractionField {
  id             String    @id // UUIDv7
  organizationId String    @map("organization_id")
  fieldName      String    @map("field_name")
  description    String
  fieldType      String    @map("field_type") // text, numeric, date, boolean, list
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, fieldName])
  @@index([organizationId, isActive])
  @@map("custom_extraction_fields")
}

model ObligationRecord {
  id                 String    @id // UUIDv7
  organizationId     String    @map("organization_id")
  documentId         String    @map("document_id")
  documentVersionId  String    @map("document_version_id")
  fieldName          String    @map("field_name")
  fieldValue         String?   @map("field_value")
  fieldValueNumeric  Decimal?  @map("field_value_numeric") @db.Decimal(20, 4)
  fieldValueDate     DateTime? @map("field_value_date")
  fieldType          String    @map("field_type") // text, numeric, date, boolean, list
  confidenceScore    Decimal?  @map("confidence_score") @db.Decimal(4, 3)
  extractionMethod   String    @map("extraction_method") // ai_llm, ocr_llm, manual
  isCustomField      Boolean   @default(false) @map("is_custom_field")
  isVerified         Boolean   @default(false) @map("is_verified")
  pendingUpdate      Json?     @map("pending_update") // for amendment review per RULE PORT-001
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document           Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentVersion    DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)

  @@index([organizationId, documentId])
  @@index([organizationId, fieldName])
  @@index([organizationId, fieldValueDate])
  @@map("obligation_records")
}

// -----------------------------------------------------------------------------
// 13. Risk-Adaptive Identity Verification (Sprint 3.7)
// -----------------------------------------------------------------------------

model PreVerifiedSigner {
  id                 String   @id // UUIDv7
  emailHash          String   @unique @map("email_hash") // SHA-256 of lowercase trimmed email
  verificationMethod String   @map("verification_method") // kba, id_document, qes
  verifiedAt         DateTime @map("verified_at")
  expiresAt          DateTime @map("expires_at")
  createdAt          DateTime @default(now()) @map("created_at")

  @@index([emailHash])
  @@index([expiresAt])
  @@map("pre_verified_signers")
}

model RiskAssessment {
  id                 String   @id // UUIDv7
  organizationId     String   @map("organization_id")
  signerId           String?  @map("signer_id")
  documentId         String?  @map("document_id")
  signatureRequestId String?  @map("signature_request_id")
  riskScore          Float    @map("risk_score") // 0.0 - 1.0
  riskLevel          String   @map("risk_level") // low, medium, high
  assignedMethod     String   @map("assigned_method")
  isPreVerified      Boolean  @default(false) @map("is_pre_verified")
  fallbackApplied    Boolean  @default(false) @map("fallback_applied")
  factors            Json?    @map("factors")
  ipAddress          String?  @map("ip_address")
  userAgent          String?  @map("user_agent")
  createdAt          DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([signerId])
  @@index([documentId])
  @@index([signatureRequestId])
  @@map("risk_assessments")
}



